  "scripts": [
    {"scenario": "值类型还是引用类型", "tags": ["结构体", "类", "值语义", "怎么选"], "template": "默认结构体（值语义线程安全）；需要继承/共享可变状态用类；小数据值类型优先；大对象考虑成本；协议优先组合"},
    {"scenario": "内存与循环引用", "tags": ["循环引用", "内存泄漏", "weak", "怎么防"], "template": "闭包捕获 self 用 [weak self]；代理用 weak；unowned 仅确定生命周期更长时；Instruments Leaks 检查；值类型天然避免"},
    {"scenario": "并发与 Actor", "tags": ["并发", "Actor", "async", "数据竞争"], "template": "共享可变状态隔离进 Actor；UI 更新在 MainActor；Task 管理异步工作；避免 Task.sleep 替代依赖；并发测试用 await 等待"},
    {"scenario": "SwiftUI 状态管理", "tags": ["SwiftUI", "状态", "绑定", "架构"], "template": "@State 局部、@Observable 共享；@Binding 传递；MVVM 用 ObservableObject；单向数据流；视图小步拆分降重算"},
    {"scenario": "异步数据流", "tags": ["Combine", "异步", "数据流", "怎么用"], "template": "Combine 处理事件流；async sequence 处理序列；网络用 async/await 更简洁；Combine 适合 UI 绑定与去抖；取消订阅防泄漏"},
    {"scenario": "SwiftUI 性能优化", "tags": ["SwiftUI", "性能", "卡顿", "优化"], "template": "减少动态 body 计算；稳定类型避免重渲染；List 懒加载；图片异步解码缓存；Instruments Time Profiler 定位"},
    {"scenario": "数据持久化选型", "tags": ["SwiftData", "Core Data", "存储", "选型"], "template": "轻量结构化用 SwiftData；复杂关系模型用 Core Data；简单 KV 用 UserDefaults；大文件用文件系统；迁移方案先行"},
    {"scenario": "网络层设计", "tags": ["网络", "URLSession", "API", "怎么设计"], "template": "URLSession + async/await；请求抽象协议化；错误处理与重试；超时与取消传播；Mock 协议化测试"},
    {"scenario": "App 生命周期处理", "tags": ["生命周期", "后台", "内存警告", "怎么处理"], "template": "scenePhase 监听前后台；后台保存状态；内存警告清理缓存；恢复流程幂等；深链统一路由入口"},
    {"scenario": "iOS 发布流程", "tags": ["发布", "App Store", "上架", "签名"], "template": "签名证书与描述文件管理；TestFlight 内测；审核注意事项（权限描述/隐私清单）；版本与构建号管理；灰度与回滚预案"}
  ]
