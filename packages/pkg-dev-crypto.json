  "scripts": [
    {"scenario": "加密方案选型", "tags": ["加密", "选型", "AES还是RSA", "怎么加密"], "template": "数据加密用 AES-GCM 认证加密；密钥分发用非对称（椭圆曲线优先）；完整性用哈希；混合方案：非对称换密钥+对称加密数据"},
    {"scenario": "密钥管理实践", "tags": ["密钥管理", "密钥怎么存", "轮换"], "template": "密钥与代码分离；硬件安全模块或托管服务存储；定期轮换并支持双密钥过渡；访问控制最小权限；审计密钥使用"},
    {"scenario": "口令存储", "tags": ["口令", "密码存储", "加盐", "怎么存密码"], "template": "绝不明文/弱哈希；用专门口令哈希（bcrypt/argon2）；每用户随机盐；工作因子平衡性能；登录限速防爆破"},
    {"scenario": "TLS 配置", "tags": ["TLS", "HTTPS", "证书", "怎么配置"], "template": "证书链完整；禁用弱协议与旧密码套件；OCSP 装订；HSTS 开启；密钥长度与哈希强度符合现行标准"},
    {"scenario": "零知识证明应用", "tags": ["零知识", "ZK", "同态", "隐私", "怎么用"], "template": "明确可验证但需隐藏的数据；ZK-SNARK 性能好但需可信设置；ZK-STARK 无需可信设置；同态加密适合外包计算；评估证明生成成本"},
    {"scenario": "密码学实现安全", "tags": ["密码学", "实现", "安全", "别自己写"], "template": "优先用审计过的库而非自研；恒定时间比较防时间攻击；随机数用密码学安全源；关注弃用算法迁移（MD5/SHA1）"}
  ]
