  "scripts": [
    {"scenario": "转化率诊断", "tags": ["转化率", "转化", "漏斗", "怎么诊断", "为什么没转化"], "template": "先分流量质量（爬虫/自测/真人）再谈漏斗；爬虫与自测会虚高访问导致转化率失真；检查每层漏斗（访问→下载→安装→激活→付费）真实口径；流量不足时先解决触达而非文案"},
    {"scenario": "UTM 渠道设计", "tags": ["UTM", "渠道", "追踪", "埋点", "怎么设计"], "template": "每个推广渠道统一带 utm_source 参数；渠道名简短唯一（v2ex/juejin/opc）；仪表盘按渠道聚合访问量；对比渠道效果指导加码；发布物料里标注对应 UTM"},
    {"scenario": "埋点方案设计", "tags": ["埋点", "回传", "统计", "安装回传", "怎么设计"], "template": "安装即回传（脚本/包管理器钩子）；失败重试防丢；匿名聚合不含内容；排除自测与测试实例；漏斗里区分真实/含自测口径"},
    {"scenario": "推荐裂变设计", "tags": ["推荐", "裂变", "邀请", "奖励", "怎么设计"], "template": "双方得利（推荐人与新用户各得额度）；推荐码绑定买主、支付成功自动发放；邀请链接带推荐码直达；台账可查防刷；奖励与成本匹配"},
    {"scenario": "运营仪表盘建设", "tags": ["仪表盘", "运营", "数据", "快照", "怎么建"], "template": "KPI 卡（访问/下载/回传/付费/营收）；转化漏斗图；渠道来源表；趋势图；试用临期与过期清单；cron 定时快照聚合；管理接口 token 保护"},
    {"scenario": "推广文案写作", "tags": ["推广", "文案", "痛点", "怎么写"], "template": "痛点开头（答得泛/烧钱/知识不沉淀）而非功能清单；三痛点卡→对应解法；在线体验降低理解门槛；真实证词增强信任；CTA 明确（先体验/免费下载）"},
    {"scenario": "用户证词沉淀", "tags": ["证词", "口碑", "反馈", "沉淀"], "template": "真实使用者原话引用；提炼多维度体验点（决策深度/省token/易用性）；首页与 README 双处展示；匿名尊重隐私；持续收集第三方反馈增强可信度"},
    {"scenario": "冷启动渠道选择", "tags": ["冷启动", "渠道", "推广", "怎么选", "从哪里开始"], "template": "官方社区发帖+回复相关讨论（精准受众）；awesome 列表 PR 收录（长期流量）；工具导航站投稿（垂直受众）；内容平台（掘金/知乎）长文带钩子；每渠道带 UTM 度量效果"},
    {"scenario": "试用到期提醒设计", "tags": ["试用", "到期", "提醒", "转化", "怎么设计"], "template": "试用密钥带到期时间；临期（≤3天）校验响应附购买提醒；过期 fail-closed 引导购买；运营端列出临期/过期清单跟进；提醒文案含优惠钩子"},
    {"scenario": "数据净化", "tags": ["数据", "净化", "爬虫", "真实", "统计口径"], "template": "过滤自测 IP 与扫描器 UA（censys/zgrab/统一UA）；页面浏览才计访问（排除 API 轮询）；真实口径与总口径并列展示；分析前先净化再下结论"}
  ]
}
