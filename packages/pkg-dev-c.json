  "scripts": [
    {"scenario": "指针使用规范", "tags": ["指针", "悬垂", "空指针", "怎么用"], "template": "初始化即赋值或 NULL；释放后置 NULL；所有权明确（谁分配谁释放）；边界检查防越界；函数参数传递用指针的场景明确"},
    {"scenario": "内存安全", "tags": ["内存泄漏", "缓冲区", "安全", "怎么防"], "template": "配对 malloc/free 或封装 RAII 风格；检查 strcpy→strncpy/安全函数；数组边界显式检查；Valgrind/ASan 定期检测；资源清理统一出口"},
    {"scenario": "头文件组织", "tags": ["头文件", "include", "模块", "怎么组织"], "template": "头文件放声明不放定义；include guard 防重；最小包含原则；接口与实现分离；extern C 处理 C++ 互操作"},
    {"scenario": "错误处理策略", "tags": ["错误处理", "errno", "返回值", "怎么处理"], "template": "返回值约定错误码；errno 用前清空；错误路径资源清理；逐层传播或集中处理；日志记录上下文"},
    {"scenario": "并发编程", "tags": ["线程", "互斥", "并发", "pthread"], "template": "临界区最小化；锁顺序一致防死锁；条件变量配互斥；volatile 不替代同步；线程安全函数标注"},
    {"scenario": "构建系统选型", "tags": ["构建", "make", "CMake", "选型"], "template": "小项目 make 足够；跨平台库用 CMake；依赖管理用包管理器；编译选项（-Wall -O2）；Debug/Release 分离"},
    {"scenario": "未定义行为排查", "tags": ["未定义行为", "UB", "UBsan", "排查"], "template": "UBsan/ASan 开启检测；有符号溢出检查；移位越界审查；严格别名违规修复；优化级别下复现验证"},
    {"scenario": "C 与 C++ 互操作", "tags": ["C", "C++", "互操作", "extern"], "template": "extern \"C\" 包裹 C 头文件；名称修饰避免；内存所有权跨语言明确；异常不能跨 C 边界；类型转换显式"},
    {"scenario": "嵌入式 C 实践", "tags": ["嵌入式", "C", "寄存器", "volatile"], "template": "寄存器访问用 volatile；中断服务函数短小；位操作清晰可读；内存映射外设结构体；无动态分配偏好"},
    {"scenario": "C 代码性能", "tags": ["C", "性能", "优化", "编译器"], "template": "先 profile 再优化；局部性优先；循环展开交给编译器；restrict 助优化；位运算替代除法（可读性优先时谨慎）"}
  ]
