  "scripts": [
    {"scenario": "协程选型", "tags": ["协程", "线程", "异步", "怎么选"], "template": "并发任务用协程替代线程；IO 密集用 Dispatchers.IO；CPU 密集用 Default；主线程更新 UI 用 Main；协程作用域与生命周期绑定"},
    {"scenario": "协程结构化并发", "tags": ["结构化并发", "作用域", "取消", "怎么用"], "template": "父作用域取消传播到子；withContext 切换调度器；SupervisorJob 隔离失败；协程取消是协作式需检查；异常按作用域层级传播"},
    {"scenario": "Flow 数据流", "tags": ["Flow", "StateFlow", "热流冷流", "怎么用"], "template": "冷流按订阅者触发；StateFlow 持有状态适合 UI；SharedFlow 广播事件；背压用 conflate/buffer；collect 在协程中调用"},
    {"scenario": "空安全实践", "tags": ["空安全", "可空类型", "NPE", "怎么处理"], "template": "可空类型显式标注 ?；safe call ?. 链式；Elvis ?: 提供默认；!! 仅在确定非空时用；平台类型边界转可空"},
    {"scenario": "Compose 架构", "tags": ["Compose", "UI", "状态", "架构"], "template": "状态提升与单向数据流；remember 保存状态；ViewModel 持有业务状态；StateFlow collectAsState；重组最小化（稳定类型）"},
    {"scenario": "Kotlin 后端选型", "tags": ["Kotlin", "后端", "Ktor", "Spring", "选型"], "template": "轻量异步选 Ktor；企业生态选 Spring Boot；协程天然适配 Ktor；序列化用 kotlinx.serialization；测试用 kotest"},
    {"scenario": "协程异常处理", "tags": ["协程", "异常", "崩溃", "怎么处理"], "template": "launch 异常进父协程；async 异常在 await 抛出；SupervisorJob 隔离兄弟；CoroutineExceptionHandler 兜底；Flow 用 catch 操作符"},
    {"scenario": "Kotlin 与 Java 互操作", "tags": ["Kotlin", "Java", "互操作", "迁移"], "template": "Java 调用 Kotlin 需注意默认参数；@JvmStatic/@JvmOverloads 适配；平台类型可空性边界；迁移渐进（文件级转换）；保留 Java 测试"},
    {"scenario": "多平台开发", "tags": ["多平台", "KMP", "共享代码", "怎么用"], "template": "业务逻辑共享、UI 各平台原生；expect/actual 声明平台差异；共享模块用 commonMain；依赖库选择支持 KMP 的；CI 多平台构建"},
    {"scenario": "协程性能排查", "tags": ["协程", "泄漏", "卡顿", "排查"], "template": "协程泄漏查作用域未取消；卡顿查主线程阻塞（IO 放错调度器）；Flow 背压堆积查缓冲；用 coroutine debugger 追踪；结构化并发根治"}
  ]
