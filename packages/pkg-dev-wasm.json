  "scripts": [
    {"scenario": "WebAssembly 技术选型", "tags": ["WebAssembly", "wasm", "选型", "什么时候用"], "template": "性能敏感或复用原生库选 wasm；插件安全隔离是强场景；跨语言共享逻辑选组件模型；纯 Web 逻辑优先 JS 保持简单；评估体积与启动成本"},
    {"scenario": "Rust 编译到 wasm", "tags": ["Rust", "wasm", "wasm-pack", "怎么编译"], "template": "wasm-pack 或 cargo build --target wasm32；wasm-bindgen 处理类型桥接；优化体积用 wasm-opt；wasm32-wasi 用于服务端/边缘"},
    {"scenario": "内存与数据传递", "tags": ["wasm", "内存", "线性内存", "数据传递"], "template": "数字标量直接传参；字符串/数组拷贝到线性内存；避免频繁跨边界；大对象共享内存零拷贝；边界所有权清晰"},
    {"scenario": "插件系统设计", "tags": ["wasm", "插件系统", "沙箱", "怎么设计"], "template": "宿主定义导入 API 白名单；插件导出标准接口；线性内存隔离；WASI 能力按需授予；版本兼容用组件模型接口"},
    {"scenario": "wasm 性能优化", "tags": ["wasm", "性能", "优化"], "template": "热点留在 wasm 内部减少边界；SIMD 向量化；线程并行（共享内存）；wasm-opt 优化；启动用 streaming compile 与缓存"},
    {"scenario": "边缘计算实践", "tags": ["wasm", "边缘计算", "FaaS", "怎么用"], "template": "函数即服务冷启动敏感选 wasm 运行时（毫秒级）；确定性利于复现；资源受限用轻量运行时（wasmtime/wasmer）；多租户靠沙箱隔离"}
  ]
