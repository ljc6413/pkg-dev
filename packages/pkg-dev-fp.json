    {"scenario": "函数式风格落地", "tags": ["函数式", "怎么用", "落地", "面向对象还是函数式"], "template": "核心逻辑纯函数化；副作用隔离到边界；不可变数据优先；组合优于继承；在主流语言渐进采用而非全盘切换"},
    {"scenario": "副作用管理", "tags": ["副作用", "IO", "状态", "怎么处理"], "template": "副作用推到应用边界；依赖注入替代全局状态；可选 Monad 处理空值；错误用 Either/Result；effect 系统渐进引入"},
    {"scenario": "数据结构选择", "tags": ["不可变", "数据结构", "怎么选"], "template": "普通场景用持久化结构（共享结构省内存）；频繁修改考虑可变局部；树/哈希 trie 按操作复杂度选；基准验证取舍"},
    {"scenario": "递归与性能", "tags": ["递归", "尾递归", "栈溢出", "优化"], "template": "尾递归避免栈溢出；复杂递归改迭代或用 trampoline；深度可控时自然递归；记忆化缓存重复计算；栈限制评估"},
    {"scenario": "类型驱动设计", "tags": ["类型驱动", "ADT", "建模", "怎么设计"], "template": "用代数数据类型建模领域（product/sum）；使非法状态不可表示；模式匹配穷尽检查；类型约束先于实现；小步重构到类型安全"},
    {"scenario": "函数式改造现有代码", "tags": ["函数式", "改造", "重构", "迁移"], "template": "从纯函数提取开始；识别可变状态边界；以不可变替换可变对象；用管道替代嵌套循环；测试覆盖保障重构；渐进分模块迁移"}
