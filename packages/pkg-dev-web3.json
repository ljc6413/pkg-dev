  "scripts": [
    {"scenario": "区块链应用选型", "tags": ["区块链", "Web3", "要不要用", "选型"], "template": "去中心化需求真实评估（信任/抗审查/多方对账）；数据公开成本；性能与 Gas 预算；联盟链 vs 公链；中心化方案对比后再定"},
    {"scenario": "智能合约开发", "tags": ["智能合约", "Solidity", "怎么写", "开发"], "template": "明确状态与函数权限；修饰符控制访问；事件记录状态变更；Gas 优化（存储/循环）；测试覆盖边界与攻击场景"},
    {"scenario": "智能合约安全", "tags": ["合约安全", "重入", "漏洞", "怎么防"], "template": "检查-生效-交互模式防重入；算术用 SafeMath/0.8 内建检查；权限最小化；外部调用失败处理；上线前专业审计"},
    {"scenario": "Gas 优化", "tags": ["Gas", "优化", "省手续费"], "template": "减少存储读写（最贵操作）；批量操作合并；事件替代存储；字符串/数组省用；上线前 Gas 预估与基准"},
    {"scenario": "代币合约设计", "tags": ["代币", "ERC-20", "ERC-721", "怎么设计"], "template": "标准接口合规（transfer/approve 语义）；铸币/销毁权限控制；可升级模式评估；快照与治理扩展；测试网验证标准兼容"},
    {"scenario": "DApp 架构", "tags": ["DApp", "前端", "钱包", "架构"], "template": "前端连钱包（EIP-1193）；链上链下数据分离；签名消息校验；交易状态机（pending/confirm）；索引服务（The Graph）"},
    {"scenario": "DeFi 协议设计", "tags": ["DeFi", "借贷", "闪电贷", "流动性"], "template": "清算阈值与预言机喂价；闪电贷攻击面评估（价格操纵）；流动性池无常损失说明；复合风险建模；审计与保险机制"},
    {"scenario": "合约升级策略", "tags": ["合约升级", "代理", "迁移", "怎么做"], "template": "代理模式（transparent/UUPS）与存储布局兼容；升级权限多签；迁移数据方案；时间锁缓冲；回滚预案"},
    {"scenario": "密钥与钱包安全", "tags": ["密钥", "钱包", "私钥", "安全"], "template": "私钥绝不进前端/日志；硬件钱包冷存储；助记词离线备份；交易签名隔离；权限分级多签"},
    {"scenario": "测试与部署", "tags": ["合约测试", "部署", "测试网", "主网"], "template": "本地 Hardhat/Foundry 测试；分叉测试真实状态；测试网验证；部署脚本幂等；部署后验证与监控；紧急暂停机制"}
  ]
