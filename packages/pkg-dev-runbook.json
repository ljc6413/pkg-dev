  "scripts": [
    {"scenario": "重建 release zip", "tags": ["release zip", "重建zip", "打包", "发行包", "怎么打包", "zip 重建", "发布包"], "template": "服务器 zip 命令打包保持正斜杠（Windows Compress-Archive 会产出反斜杠破坏 Linux 解压）；源目录上传后 zip -r -X；部署到 /opt/yihe-server/public/；unzip -o 验证文件数与包数"},
    {"scenario": "重建 npm tgz", "tags": ["npm tgz", "npm pack", "打包npm", "tgz重建", "npm 包"], "template": "pkg-dev-repo 下 npm pack --pack-destination；npm 缓存目录需可写（--cache 指定）；tgz 是 gzip+tar 非 zip 不能当 zip 读；部署到服务器 public 并替换 GitHub Release 资产"},
    {"scenario": "PRO_PACKS 三处同步", "tags": ["PRO_PACKS", "三处同步", "白名单", "新增包", "同步白名单", "pro_packs"], "template": "改三处保持一致：① 内置插件 index.js（app.asar.unpacked）② 工作区 yihe-shared-static-fixed.js ③ 服务器 Rust license.rs（sed 替换 + cargo check）；内置插件改动需 DSH 重启生效"},
    {"scenario": "服务器部署新包", "tags": ["服务器部署", "部署新包", "PACK_DIR", "上传包", "重启内核"], "template": "scp 包 JSON 到 /opt/yihe-server/public/packages/；systemctl restart yihe-server；journalctl 查『已加载 N/N 个编程包』确认；curl demo/reason 路由验证新领域"},
    {"scenario": "GitHub 推送", "tags": ["GitHub推送", "git push", "推送失败", "仓库更新", "提交"], "template": "git 直连 github.com 从服务器常断（TLS/超时），用 git data API 更稳：blob→tree→commit→ref 单 commit 批量推多文件；或 Contents API 单文件；均带 token 与重试"},
    {"scenario": "Release 资产替换", "tags": ["Release资产", "替换资产", "更新下载", "assets", "上传资产"], "template": "GET releases 找 tag 与旧资产 id→DELETE 旧资产→uploads.github.com POST 新文件（octet-stream）；DELETE 204 无 body 需容错；替换后验证浏览器下载 URL"},
    {"scenario": "跑冒烟测试", "tags": ["冒烟", "selfcheck", "smoke", "测试包", "RFB检查"], "template": "node tools/smoke-test.mjs --selfcheck（包意象/关系/脚本完整性）+ --rfb（asm 源检查）；PACKS 数组加新包断言；CI 里 27→包数断言同步改"},
    {"scenario": "更新 bootstrap 包列表", "tags": ["bootstrap", "包列表", "安装器", "PACKS 数组"], "template": "bootstrap-install.mjs 的 PACKS 数组加新包 id；phase 文案包数同步改；node --check 验证语法；同步到 release 目录与服务器"},
    {"scenario": "证书与域名排查", "tags": ["证书", "域名", "打不开", "TLS", "PR_CONNECT_RESET", "访问失败"], "template": "先查服务端（curl 本机、nginx 状态、证书有效期 openssl x509 -dates、ss 端口）确认服务端正常；客户端报错多为本地路径（DNS 缓存/代理/安全软件）——换网络/清 DNS/无痕验证"},
    {"scenario": "运营快照重跑", "tags": ["快照", "ops-snapshot", "重跑", "运营数据", "仪表盘数据"], "template": "sudo GH_TOKEN=xxx node /opt/yihe-server/scripts/ops-snapshot.mjs；检查输出行（visits/dl/tel/gh）；验证 /api/ops?token= 返回最新 generated_at"},
    {"scenario": "避免重复烧 token", "tags": ["省token", "烧token", "重复", "常规操作", "沉淀", "减少消耗"], "template": "确定性常规操作写成包脚本（scenario/tags/template）→ 开启 script_hit_threshold=0.5 → 命中即 0 token 返回；操作步骤固化为 runbook 文档供直接查；不重复推演已知流程"},
    {"scenario": "工具链语法预检", "tags": ["node --check", "语法检查", "工具检查", "部署前检查"], "template": "部署前 node --check 全部改动文件（server.js/ops-snapshot/bootstrap/工具 mjs）；CI 里 for f in tools/*.mjs 批量检查；失败先修再部署"}
  ]
}
